{
  "name": "@fokion/tessera",
  "version": "0.4.0",
  "description": "A configurable, unstyled dashboard grid with arrange mode, per-widget config and pluggable persistence.",
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fokion/tessera.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tessera.css": "./dist/tessera.css"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:diagrams": "docker run --rm -v \"$PWD:/work\" -w /work plantuml/plantuml:1.2026.2 -tsvg -o /work/docs/diagrams docs/c4/*.puml docs/plantuml/*.puml",
    "docs:check": "docker run --rm -v \"$PWD:/work\" -w /work plantuml/plantuml:1.2026.2 -checkonly docs/c4/*.puml docs/plantuml/*.puml"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
